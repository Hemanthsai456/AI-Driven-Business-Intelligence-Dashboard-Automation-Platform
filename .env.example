# ==============================================================================
# AI-Driven Business Intelligence & Dashboard Automation Platform
# Environment Configuration Template
#
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Fill in your actual API keys and preferences in '.env'.
# 3. DO NOT commit '.env' to version control or execute it as a script!
# ==============================================================================

# ------------------------------------------------------------------------------
# Active LLM Provider Selection
# Options: 'gemini' | 'groq' | 'ollama'
# ------------------------------------------------------------------------------
PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Configuration
# Get your API key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Groq Configuration (Fast Inference Cloud API)
# Get your API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Ollama Configuration (Local LLM - No API Key Required!)
# Ollama runs locally on your machine and does NOT require an API key.
# Download & install Ollama: https://ollama.ai/
# Start with: ollama run llama3
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ------------------------------------------------------------------------------
# Platform & Pipeline Settings
# ------------------------------------------------------------------------------
# Generator mode: 'llm_only' or 'parallel'
GENERATOR_MODE=llm_only

# Agent feedback loop (true/false)
AGENT_LOOP=false

# Evaluation mode / benchmark tracing (true/false)
EVAL_MODE=false

# Run live integration tests against external APIs (1 = enabled, 0 = disabled)
RUN_LIVE_TESTS=0

# ------------------------------------------------------------------------------
# Frontend Settings (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
